# Copy to .env and fill in real values. Never commit the real .env file.

# --- LLM provider selection -------------------------------------------------
# One of: claude (default), groq, ollama
LLM=claude

# Required when LLM=claude (default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required when LLM=groq (free tier available at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Used when LLM=ollama — must point at a locally/network-reachable Ollama daemon
OLLAMA_MODEL=llama3.1:8b

# --- Auth --------------------------------------------------------------------
# Shared secret clients must send as the X-API-Key header on every
# data-touching request (/query, /query/stream, /datasets*, /schema, /examples).
# If left unset, auth is disabled (local-dev convenience only) — always set
# this in any deployed environment.
API_KEY=change_me_to_a_long_random_value

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed origins. Defaults to the typical Vite dev
# port if unset.
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting -----------------------------------------------------------
# Max requests per 60s window per API key (or per client IP if API_KEY unset).
# In-memory only — correct for a single instance; needs Redis if scaled out.
RATE_LIMIT_PER_MINUTE=20

# --- Uploaded dataset garbage collection --------------------------------------
# How long an uploaded dataset is kept on disk before being deleted, and how
# often the cleanup sweep runs, both in seconds.
UPLOAD_TTL_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=3600
